<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Lovecare" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Modern Midnight Romantic Palette -->
        <item name="colorPrimary">#FF4D6D</item>
        <item name="colorSecondary">#7B61FF</item>
        <item name="android:navigationBarColor">#0A0714</item>
        <item name="android:statusBarColor">#0A0714</item>
        <item name="android:windowBackground">#0A0714</item>
    </style>

    <!-- Style for Circular Images -->
    <style name="CircleImage">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Ultra-Modern Bold Calendar Theme -->
    <style name="CustomCalendarTheme" parent="Theme.AppCompat">
        <item name="android:calendarViewStyle">@style/MyCalendarViewStyle</item>
    </style>

    <style name="MyCalendarViewStyle" parent="android:Widget.CalendarView">
        <item name="android:focusedMonthDateColor">#FFFFFF</item>
        <item name="android:unfocusedMonthDateColor">#4DFFFFFF</item>
        <item name="android:weekSeparatorLineColor">#00000000</item>
        <item name="android:showWeekNumber">false</item>
        <item name="android:dateTextAppearance">@style/CalendarDateText</item>
        <item name="android:weekDayTextAppearance">@style/CalendarWeekDayText</item>
    </style>

    <style name="CalendarDateText">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalendarWeekDayText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#FF758F</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>