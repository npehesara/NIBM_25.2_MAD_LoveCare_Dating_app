<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AdminDashboardActivity" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/primary_pink</item>
    </style>

    <style name="Theme.Lovecare" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">#FF2E93</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <!-- Material 3 Navigation Bar "Pill" color -->
        <item name="colorSecondaryContainer">#FFFFFF</item>
        <item name="colorOnSecondaryContainer">#000000</item>

        <!-- Navigation bar system background color -->
        <item name="android:navigationBarColor">#0F0F0F</item>

        <!-- Ensure BottomNavigationView uses Material 3 style -->
        <item name="bottomNavigationStyle">@style/Widget.Material3.BottomNavigationView</item>
    </style>

    <!-- Style for Circular Images -->
    <style name="CircleImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Custom Calendar Theme -->
    <style name="CustomCalendarTheme" parent="Theme.AppCompat">
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:colorControlActivated">#FF2E93</item>
        <item name="android:textColorSecondary">#9E9E9E</item>
    </style>
</resources>