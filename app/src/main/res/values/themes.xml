<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.DA_Messaging_module" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <!-- Use ThemeOverlay as parent for android:theme to avoid infinite cycles in layout renderer.
         Widget.AppCompat.SearchView should not be used as a theme parent. -->
    <style name="SearchViewBlack" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColor">#000000</item>
        <item name="android:textColorHint">#666666</item>
        <item name="colorControlNormal">#000000</item>
    </style>
</resources>