<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#1F1B2E"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:strokeColor="#30FF4D6D"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- User Photo / Avatar -->
        <FrameLayout
            android:id="@+id/flStarredAvatar"
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivStarredPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:strokeColor="#FFD700"
                app:strokeWidth="3dp" />

            <!-- Fallback Letter Avatar -->
            <FrameLayout
                android:id="@+id/flStarredLetterAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_pink_circle"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvStarredAvatarLetter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="A"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </FrameLayout>

        <!-- Star Badge on Photo -->
        <TextView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_pink_circle"
            android:backgroundTint="#FFD700"
            android:gravity="center"
            android:text="⭐"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/flStarredAvatar"
            app:layout_constraintEnd_toEndOf="@id/flStarredAvatar" />

        <!-- User Name & Details -->
        <LinearLayout
            android:id="@+id/llStarredDetails"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnLikeBack"
            app:layout_constraintStart_toEndOf="@id/flStarredAvatar"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvStarredName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Name"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStarredInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="📅 Age: 24  •  ❤️ Straight"
                android:textColor="#B0FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvStarredBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/badge_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="⭐ You Super Liked"
                android:textColor="#FFD700"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Message / Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLikeBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Message 💬"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="#FF4D6D"
            app:cornerRadius="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
