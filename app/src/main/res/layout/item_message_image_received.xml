<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="3dp">

    <!-- Partner letter avatar -->
    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="bottom"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_pink_circle">

        <TextView
            android:id="@+id/tvPartnerAvatarLetter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </FrameLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="64dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#2A2438">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp">

            <!-- LAYER 1 (bottom): actual image — always VISIBLE so Glide loads it -->
            <ImageView
                android:id="@+id/ivMessageImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Received image"
                android:scaleType="centerCrop" />

            <!-- LAYER 2 (top): letter placeholder overlay — hides once image loads -->
            <FrameLayout
                android:id="@+id/flImagePlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#CC000000">

                <TextView
                    android:id="@+id/tvImagePlaceholderLetter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="52sp"
                    android:textStyle="bold"
                    android:alpha="0.6" />
            </FrameLayout>

            <!-- Time overlay at bottom-left -->
            <TextView
                android:id="@+id/tvMessageTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="6dp"
                android:background="#80000000"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
