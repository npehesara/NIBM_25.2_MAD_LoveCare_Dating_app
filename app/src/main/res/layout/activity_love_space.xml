<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/loveSpaceRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0714"
    tools:context=".LoveSpaceActivity">

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/lovespace_title"
        android:textColor="#FF4D6D"
        android:textSize="34sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:letterSpacing="0.15"
        android:shadowColor="#80FF4D6D"
        android:shadowRadius="25"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Close LoveSpace button -->
    <ImageView
        android:id="@+id/btnCloseLoveSpace"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="20dp"
        android:src="@drawable/ic_back"
        android:rotation="180"
        android:padding="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Close LoveSpace"
        android:visibility="gone"
        app:tint="#FF4D6D"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Empty state when no LoveSpace is active -->
    <LinearLayout
        android:id="@+id/llEmptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💔"
            android:textSize="64sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="No Active LoveSpace"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Like someone and get liked back to create one!"
            android:textColor="#80FFFFFF"
            android:textSize="14sp"
            android:gravity="center" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/xpCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="#1F1B2E"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="#30FF4D6D"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvLevelInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/level"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvXpRatio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xp_ratio"
                    android:textColor="#FF758F"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/tvLevelInfo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvLevelInfo" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/xpProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:indicatorColor="#FF4D6D"
                app:trackColor="#2D2844"
                app:trackCornerRadius="10dp"
                app:trackThickness="10dp"
                android:progress="85" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/coupleVisualContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/xpCard">

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginHorizontal="80dp"
            android:background="#FF4D6D"
            android:alpha="0.3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <FrameLayout
            android:id="@+id/userProfileContainer"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginStart="24dp"
            android:clickable="true"
            android:focusable="true"
            android:longClickable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Fallback Letter Avatar -->
            <FrameLayout
                android:id="@+id/flUserLetterAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="6dp"
                android:background="@drawable/bg_pink_circle">

                <TextView
                    android:id="@+id/tvUserAvatarLetter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="U"
                    android:textColor="#FFFFFF"
                    android:textSize="44sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivUserProfile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:scaleType="centerCrop"
                android:clickable="false"
                android:visibility="invisible"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:strokeColor="#FF4D6D"
                app:strokeWidth="4dp" />

            <TextView
                android:id="@+id/tvUserEmojiOverlay"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/edittext_bg"
                android:backgroundTint="#2D2844"
                android:gravity="center"
                android:elevation="8dp"
                android:textSize="22sp"
                android:visibility="gone"
                tools:text="😊"
                tools:visibility="visible" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvHeartEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💞"
            android:textSize="50sp"
            android:shadowColor="#FF4D6D"
            android:shadowRadius="20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/partnerProfileContainer"
            app:layout_constraintStart_toEndOf="@+id/userProfileContainer"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Partner Profile (Right) -->
        <FrameLayout
            android:id="@+id/partnerProfileContainer"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Fallback Letter Avatar -->
            <FrameLayout
                android:id="@+id/flPartnerLetterAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="6dp"
                android:background="@drawable/bg_pink_circle">

                <TextView
                    android:id="@+id/tvPartnerAvatarLetter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="P"
                    android:textColor="#FFFFFF"
                    android:textSize="44sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivPartnerProfile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:scaleType="centerCrop"
                android:visibility="invisible"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:strokeColor="#FF4D6D"
                app:strokeWidth="4dp" />

            <TextView
                android:id="@+id/tvPartnerEmojiOverlay"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|start"
                android:background="@drawable/edittext_bg"
                android:backgroundTint="#1F1B2E"
                android:gravity="center"
                android:textSize="18sp"
                android:visibility="visible"
                android:text="💖" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/calendarCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#141122"
        app:cardCornerRadius="32dp"
        app:strokeColor="#1AFFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/coupleVisualContainer">

        <CalendarView
            android:id="@+id/calendarView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:theme="@style/CustomCalendarTheme" />
    </com.google.android.material.card.MaterialCardView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginBottom="24dp"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/social_google_bg"
        android:backgroundTint="#1F1B2E"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnGallery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:src="@drawable/ic_gallery"
            app:backgroundTint="#2D2844"
            app:tint="#FF4D6D"
            app:elevation="0dp"
            app:fabSize="mini"
            android:contentDescription="@string/desc_gallery"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="48dp"
            android:src="@drawable/ic_chat"
            app:backgroundTint="#FF4D6D"
            app:tint="#FFFFFF"
            app:elevation="8dp"
            android:contentDescription="@string/desc_message"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/emojiSelectorCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardBackgroundColor="#2D2844"
        app:cardCornerRadius="32dp"
        app:cardElevation="50dp"
        app:strokeColor="#FF4D6D"
        app:strokeWidth="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">
            <TextView android:id="@+id/tvEmoji1" android:layout_width="64dp" android:layout_height="64dp" android:gravity="center" android:text="😊" android:textSize="36sp" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackgroundBorderless"/>
            <TextView android:id="@+id/tvEmoji2" android:layout_width="64dp" android:layout_height="64dp" android:gravity="center" android:text="😍" android:textSize="36sp" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackgroundBorderless"/>
            <TextView android:id="@+id/tvEmoji3" android:layout_width="64dp" android:layout_height="64dp" android:gravity="center" android:text="🥺" android:textSize="36sp" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackgroundBorderless"/>
            <TextView android:id="@+id/tvEmoji4" android:layout_width="64dp" android:layout_height="64dp" android:gravity="center" android:text="😴" android:textSize="36sp" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackgroundBorderless"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <View
        android:id="@+id/calendarMenuDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        android:elevation="90dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/calendarContextMenuCard"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardBackgroundColor="#1F1B2E"
        app:cardCornerRadius="28dp"
        app:cardElevation="100dp"
        app:strokeColor="#FF4D6D"
        app:strokeWidth="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/btnCalendarAddEvent"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingHorizontal="24dp"
                android:text="Add Event"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_add"
                android:drawablePadding="20dp"
                app:drawableTint="#FF4D6D"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#20FFFFFF"
                android:layout_marginHorizontal="16dp" />

            <TextView
                android:id="@+id/btnCalendarViewDetails"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingHorizontal="24dp"
                android:text="View Details"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_info"
                android:drawablePadding="20dp"
                app:drawableTint="#FF4D6D"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#20FFFFFF"
                android:layout_marginHorizontal="16dp" />

            <TextView
                android:id="@+id/btnCalendarAddNote"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingHorizontal="24dp"
                android:text="Add Note"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_edit"
                android:drawablePadding="20dp"
                app:drawableTint="#FF4D6D"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>