<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainQuestionnaire"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_questionnaire">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Progress Bar at very top -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="28dp"
            android:max="100"
            android:progressTint="#FFFFFF"
            android:progressBackgroundTint="#50FFFFFF" />

        <!-- Scrollable Content Area -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="40dp"
                android:paddingBottom="24dp">

                <!-- Question Title (white, bold, centered) -->
                <TextView
                    android:id="@+id/tvQuestionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Question Title"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <!-- Question Subtitle -->
                <TextView
                    android:id="@+id/tvQuestionSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text=""
                    android:textColor="#CCFFFFFF"
                    android:textSize="15sp" />

                <!-- Single Choice Options container -->
                <LinearLayout
                    android:id="@+id/llOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="32dp"
                    android:visibility="gone" />

                <!-- Text Input container -->
                <LinearLayout
                    android:id="@+id/llTextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="32dp"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etTextInput"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/questionnaire_edittext_bg"
                        android:hint="Type here..."
                        android:textColorHint="#AAFFFFFF"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:gravity="center_vertical"
                        android:inputType="text"
                        android:singleLine="true" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnNextText"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="32dp"
                        android:background="@drawable/complete_registration_bg"
                        android:text="NEXT →"
                        android:textAllCaps="true"
                        android:textColor="#E91E63"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:enabled="false" />
                </LinearLayout>

                <!-- Photo Upload container -->
                <LinearLayout
                    android:id="@+id/llPhotoUpload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="32dp"
                    android:visibility="gone">

                    <!-- Dashed frame for photo -->
                    <FrameLayout
                        android:id="@+id/flPhotoFrame"
                        android:layout_width="240dp"
                        android:layout_height="300dp"
                        android:background="@drawable/photo_upload_border"
                        android:foreground="?attr/selectableItemBackground">

                        <!-- Plus icon (shown before photo selected) -->
                        <TextView
                            android:id="@+id/tvPlusIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="+"
                            android:textColor="#FFFFFF"
                            android:textSize="60sp"
                            android:textStyle="bold" />

                        <!-- Photo preview -->
                        <ImageView
                            android:id="@+id/ivSelectedPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Tap frame to choose from gallery"
                        android:textColor="#CCFFFFFF"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Bottom Actions area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <!-- Complete Registration button (only shown on last/photo step) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCompleteRegistration"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/complete_registration_bg"
                android:text="COMPLETE REGISTRATION ❤"
                android:textAllCaps="true"
                android:textColor="#E91E63"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Skip text button -->
            <TextView
                android:id="@+id/tvSkip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Skip"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:padding="12dp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
