<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_pink_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_admin"
                    android:textColor="@color/dark_accent"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/home_subtitle"
                    android:textColor="@color/text_grey"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Decorative Black Part (Small Dot) -->
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_icon_dark"
                android:backgroundTint="@color/dark_accent" />
        </RelativeLayout>

        <!-- Total Users Card - Modern Style -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_icon_dark"
                    android:backgroundTint="#FDE7EF">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/total_users_label"
                        android:src="@drawable/ic_users"
                        app:tint="@color/primary_pink" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_users_label"
                        android:textColor="@color/text_grey"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_total_users_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zero"
                        android:textColor="@color/dark_accent"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Black Small Part Accent -->
                <View
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:background="@color/dark_accent" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Couple Matches Card (Active LoveSpaces) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_icon_dark"
                    android:backgroundTint="#F0EFFF">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/couple_matches_label"
                        android:src="@drawable/ic_heart"
                        app:tint="#6C63FF" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/couple_matches_label"
                        android:textColor="@color/text_grey"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_couple_matches_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zero"
                        android:textColor="@color/dark_accent"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Black Small Part Accent -->
                <View
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:background="@color/dark_accent" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Breakups Card (Closed LoveSpaces) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_icon_dark"
                    android:backgroundTint="#FFEBEE">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/breakups_label"
                        android:src="@drawable/ic_heart"
                        app:tint="#FF5252" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/breakups_label"
                        android:textColor="@color/text_grey"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_breakups_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zero"
                        android:textColor="@color/dark_accent"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Red Accent -->
                <View
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:background="#FF5252" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- User Growth Chart - Dynamic Bar Chart -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tv_analytics_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@+id/tv_last_days"
                        android:text="@string/user_growth_label"
                        android:textColor="@color/dark_accent"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_last_days"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="@string/last_7_days"
                        android:textColor="@color/text_grey"
                        android:textSize="12sp" />
                </RelativeLayout>

                <!-- Dynamic Bar Chart -->
                <LinearLayout
                    android:id="@+id/ll_chart_container"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="28dp"
                    android:baselineAligned="false"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <!-- Day 0 (6 days ago) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tv_bar_count_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="@color/text_grey" android:layout_marginBottom="4dp" />
                        <View android:id="@+id/bar_0" android:layout_width="14dp" android:layout_height="4dp" android:background="@drawable/bg_icon_dark" android:backgroundTint="@color/primary_pink" android:layout_marginBottom="4dp" />
                        <View android:layout_width="4dp" android:layout_height="4dp" android:background="@color/dark_accent" />
                    </LinearLayout>

                    <!-- Day 1 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tv_bar_count_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="@color/text_grey" android:layout_marginBottom="4dp" />
                        <View android:id="@+id/bar_1" android:layout_width="14dp" android:layout_height="4dp" android:background="@drawable/bg_icon_dark" android:backgroundTint="@color/primary_pink" android:layout_marginBottom="4dp" />
                        <View android:layout_width="4dp" android:layout_height="4dp" android:background="@color/dark_accent" />
                    </LinearLayout>

                    <!-- Day 2 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tv_bar_count_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="@color/text_grey" android:layout_marginBottom="4dp" />
                        <View android:id="@+id/bar_2" android:layout_width="14dp" android:layout_height="4dp" android:background="@drawable/bg_icon_dark" android:backgroundTint="@color/primary_pink" android:layout_marginBottom="4dp" />
                        <View android:layout_width="4dp" android:layout_height="4dp" android:background="@color/dark_accent" />
                    </LinearLayout>

                    <!-- Day 3 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tv_bar_count_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="@color/text_grey" android:layout_marginBottom="4dp" />
                        <View android:id="@+id/bar_3" android:layout_width="14dp" android:layout_height="4dp" android:background="@drawable/bg_icon_dark" android:backgroundTint="@color/primary_pink" android:layout_marginBottom="4dp" />
                        <View android:layout_width="4dp" android:layout_height="4dp" android:background="@color/dark_accent" />
                    </LinearLayout>

                    <!-- Day 4 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tv_bar_count_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="@color/text_grey" android:layout_marginBottom="4dp" />
                        <View android:id="@+id/bar_4" android:layout_width="14dp" android:layout_height="4dp" android:background="@drawable/bg_icon_dark" android:backgroundTint="@color/primary_pink" android:layout_marginBottom="4dp" />
                        <View android:layout_width="4dp" android:layout_height="4dp" android:background="@color/dark_accent" />
                    </LinearLayout>

                    <!-- Day 5 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tv_bar_count_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="@color/text_grey" android:layout_marginBottom="4dp" />
                        <View android:id="@+id/bar_5" android:layout_width="14dp" android:layout_height="4dp" android:background="@drawable/bg_icon_dark" android:backgroundTint="@color/primary_pink" android:layout_marginBottom="4dp" />
                        <View android:layout_width="4dp" android:layout_height="4dp" android:background="@color/dark_accent" />
                    </LinearLayout>

                    <!-- Day 6 (Today) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tv_bar_count_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="@color/text_grey" android:layout_marginBottom="4dp" />
                        <View android:id="@+id/bar_6" android:layout_width="14dp" android:layout_height="4dp" android:background="@drawable/bg_icon_dark" android:backgroundTint="@color/primary_pink" android:layout_marginBottom="4dp" />
                        <View android:layout_width="4dp" android:layout_height="4dp" android:background="@color/dark_accent" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Day Labels -->
                <LinearLayout
                    android:id="@+id/ll_day_labels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/tv_day_0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAlignment="center" android:textSize="11sp" android:textColor="@color/text_grey" />
                    <TextView android:id="@+id/tv_day_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAlignment="center" android:textSize="11sp" android:textColor="@color/text_grey" />
                    <TextView android:id="@+id/tv_day_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAlignment="center" android:textSize="11sp" android:textColor="@color/text_grey" />
                    <TextView android:id="@+id/tv_day_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAlignment="center" android:textSize="11sp" android:textColor="@color/text_grey" />
                    <TextView android:id="@+id/tv_day_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAlignment="center" android:textSize="11sp" android:textColor="@color/text_grey" />
                    <TextView android:id="@+id/tv_day_5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAlignment="center" android:textSize="11sp" android:textColor="@color/text_grey" />
                    <TextView android:id="@+id/tv_day_6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAlignment="center" android:textSize="11sp" android:textColor="@color/text_grey" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>